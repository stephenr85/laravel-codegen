{
    "name": "rushing/laravel-codegen",
    "description": "Laravel binding for rushing/codegen: an artisan command that resolves generators from the registry, invokes them against a host-supplied model, and writes + formats the returned files. Native emitters and subprocess/other-language toolchains behind one seam.",
    "keywords": [
        "laravel",
        "codegen",
        "code-generation",
        "artisan",
        "sdk",
        "generator"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nette/php-generator": "^3.4|^4.0",
        "rushing/codegen": "dev-main",
        "rushing/laravel-popcorn": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\Codegen\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Codegen\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rushing\\Codegen\\Laravel\\CodegenServiceProvider"
            ]
        },
        "package-topology": {
            "mustRequire": [
                "rushing/codegen"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../codegen",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel-popcorn",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../php-popcorn",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    }
}
